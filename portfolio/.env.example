MAIL_API_KEY=
MAIL_TO=

KV_REST_URL=
KV_REST_TOKEN=

# Sanity CMS. All server-side: the client is never imported from a client
# component, so none of these need (or get) a NEXT_PUBLIC_ prefix.
CMS_PROJECT_ID=
CMS_DATASET=production
CMS_API_VERSION=2024-01-01

# Read-only ("viewer") API token. REQUIRED because the dataset is private.
# Create one with:
#   cd portfolio-studio && npx sanity tokens create "portfolio-frontend-read" --role viewer
# Without it the site still renders, falling back to src/content/fallbacks.ts.
CMS_READ_TOKEN=

# Engagement counters (Upstash). Keys are namespaced by environment:
#   production → portfolio:*   preview → preview:portfolio:*   local → dev:portfolio:*
# Vercel sets VERCEL_ENV for you, so nothing is needed here. Only set STATS_ENV
# if the site is ever hosted somewhere other than Vercel, where VERCEL_ENV is
# absent and the counters would otherwise stay in the dev namespace.
# STATS_ENV=production

# Absolute origin used for metadataBase / Open Graph URLs. On Vercel this falls
# back to VERCEL_PROJECT_PRODUCTION_URL, so it is only needed elsewhere.
# SITE_URL=https://example.com
